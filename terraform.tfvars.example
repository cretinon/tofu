# ---------------------------------------------------------------------------
# Example variable values.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is git-ignored: it is the place for the API token, the
# password and the container root password. Every variable listed here is
# documented in variables.tf and in README.md.
#
# No line of this file ends with a trailing comment, on purpose: `tofu fmt`
# (the wrapper's tofu_fmt, also part of the tofu_check gate) re-aligns an inline
# comment the moment its line stops being a comment, which turns uncommenting an
# option into a formatting diff. Every option therefore sits on its own line,
# explained above it and separated from the next one, and the commented blocks
# are aligned exactly the way `tofu fmt` writes them: uncomment any line (or any
# commented block) and the result is already formatted.
# ---------------------------------------------------------------------------

# --- Proxmox VE connection --------------------------------------------------

pve_endpoint = "https://pve.example.com:8006/"
pve_node     = "pve"

# API token (recommended). Prefer exporting it rather than writing it here:
#   export TF_VAR_pve_api_token='terraform@pve!provider=00000000-0000-0000-0000-000000000000'

# The same token, declared as a variable instead of an environment variable.
pve_api_token = "root@pam!opentofu=00000000-0000-0000-0000-000000000000"

# API user. Still required with an API token: the provider needs a PAM user for
# the node SSH connection unless pve_ssh_username is set.
pve_username = "root@pam"

# Password authentication as a development fallback (ignored when a token is set).
# pve_password = "change-me"

# SSH access to the node (snippet upload + disk image import). The user needs
# password-less sudo for pvesm/qm/tee. Set it explicitly: without it the
# provider reuses pve_username, which fails with an API token (a token is not a
# PAM user). Give the PAM name without its realm.
pve_ssh_username = "root"

# Path of the PEM private key. The project reads the file itself (with file()),
# which is how a key on disk is used without loading it into an ssh-agent.
pve_ssh_private_key_file = "/root/.ssh/id_rsa"

# The PEM content itself, when it must come from this file rather than from a
# path or the agent. A *.tfvars file accepts literals only, so the file() call
# belongs to pve_ssh_private_key_file above -- or export the content instead:
#   export TF_VAR_pve_ssh_private_key="$(cat /root/.ssh/id_rsa)"
# pve_ssh_private_key = "-----BEGIN OPENSSH PRIVATE KEY-----..."

# Use the local ssh-agent for the node SSH connection.
pve_ssh_agent = true

# Skip TLS verification. Only for a self-signed API certificate.
pve_insecure = true

# Random, uniqueness-checked ids for the guests that do not pin one.
# pve_random_vm_ids = true

# Minimum TLS version negotiated with the API. Lower it (for instance to "1.2")
# only for an old Proxmox node.
pve_min_tls = "1.2"

# Custom provider temp directory (empty = system default).
# pve_tmp_dir = ""

# --- Datastores -------------------------------------------------------------

# Datastore receiving the VM images and the LXC templates.
images_datastore_id = "local"

# Datastore receiving the cloud-init snippets. It must have the "snippets"
# content type enabled.
snippets_datastore_id = "local"

# Prefix of the two snippet file names. Snippet names are datastore-wide: give
# every configuration its own prefix when several of them (or a hand-uploaded
# snippet) share the datastore.
snippet_name_prefix = "tofu"

# --- Networking and access --------------------------------------------------

dns_domain  = "lab.example.com"
dns_servers = ["10.0.10.1", "10.0.10.2"]
gateway     = "10.0.10.1"

ssh_public_keys = [
  "ssh-ed25519 AAAA...replace-me admin@example.com",
]

# Admin user created by cloud-init in the VMs. Keep the default unless you also
# change the cloud image, which is where that user is defined.
# vm_admin_user = "debian"

# --- Managed OS images ------------------------------------------------------

# The defaults provision from Debian 13 ("debian13" image / "debian13-ct"
# template) and Debian 12 ("debian12" / "debian12-ct"). Overriding "images"
# replaces the whole default map, so redefine every image you still reference.
# file_name is mandatory in every entry (datastore name, extension included);
# a checksum must be a hex digest whose length matches checksum_algorithm.
# images = {
#   debian13 = {
#     content_type = "iso"
#     url          = "https://cloud.debian.org/images/cloud/trixie/20260831-2587/debian-13-genericcloud-amd64-20260831-2587.qcow2"
#     file_name    = "debian-13-genericcloud-amd64-20260831-2587.img"
#     checksum     = "8ea9faae810043a0b35b0149f05014f26705c2339ffb11ead308f33e844a87cc3ef46ec81d5262b38817b6a88af404874d48a5857ebe072ef6a31dfb6e371f50"
#   }
# }

# --- Virtual machines -------------------------------------------------------

vm = {
  "web-01" = {
    vm_name                       = "web-01"
    vm_ip                         = "10.0.10.11/24"
    vm_datastore_storage_location = "local-lvm"
    vm_cores                      = 2
    vm_memory                     = 2048
    vm_disk_size                  = 20
    vm_tags                       = ["debian13-vm", "tofu"]
    vm_bridge                     = "vmbr1"
  }

  # Every other attribute is optional and its default comes from variables.tf.
  # The second guest below spells some of them out, aligned the way `tofu fmt`
  # writes them, so uncommenting the whole block keeps it formatted: vm_id pins
  # the guest id (>= 100), vm_floating_memory lets the balloon shrink down to
  # that many MiB, and vm_protection makes Proxmox refuse to destroy the VM --
  # do not combine it with vm_recreate_on_cloud_init_change, whose rebuild would
  # be refused on a protected VM.
  # "db-01" = {
  #   vm_name                          = "db-01"
  #   vm_ip                            = "dhcp"
  #   vm_datastore_storage_location    = "local-lvm"
  #   vm_source_image                  = "debian12"
  #   vm_bridge                        = "vmbr1"
  #   vm_id                            = 131
  #   vm_memory                        = 4096
  #   vm_floating_memory               = 1024
  #   vm_nic_rate_limit                = 100
  #   vm_protection                    = true
  #   vm_recreate_on_cloud_init_change = true
  # }
}

# --- Containers -------------------------------------------------------------

# ct_id pins the container id (>= 100) instead of letting the provider pick one.
# The two optional attributes at the end of the entry are commented out; each
# sits on its own line, so uncommenting either of them needs no reformatting.

ct = {
  "dns-01" = {
    ct_name                       = "dns-01"
    ct_ip                         = "10.0.10.21/24"
    ct_datastore_storage_location = "local-lvm"
    ct_cores                      = 1
    ct_memory                     = 512
    ct_disk_size                  = 8
    ct_tags                       = ["debian13-ct", "tofu"]
    ct_bridge                     = "vmbr1"
    ct_id                         = 121

    # Proxmox protection flag: the container then refuses to be destroyed or
    # updated.
    # ct_protection = true

    # Root password of the container. Leave it unset to keep SSH-key-only
    # access; note that it is stored in the local state in clear text.
    # ct_root_password = "change-me"
  }
}
